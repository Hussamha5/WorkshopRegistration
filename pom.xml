<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- root: aggregator of core + app, and the top parent of everything -->
    <groupId>patmal.workshops.student.impl</groupId>
    <artifactId>root</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>core</module>
        <module>app</module>
    </modules>

    <properties>
        <!-- build settings -->
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- versions of the jars we got from the lecturer -->
        <patmal.api.version>2.0</patmal.api.version>
        <patmal.tester.version>2.0</patmal.tester.version>

        <!-- versions of third-party libraries -->
        <log4j.version>2.25.4</log4j.version>
        <commons-validator.version>1.10.1</commons-validator.version>
        <jackson.version>2.20.1</jackson.version>
        <commons-csv.version>1.14.1</commons-csv.version>

        <!-- versions of plugins -->
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
        <exec-maven-plugin.version>3.6.2</exec-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- our own modules -->
            <dependency>
                <groupId>patmal.workshops.student.impl</groupId>
                <artifactId>model-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>patmal.workshops.student.impl</groupId>
                <artifactId>logic-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- the API jars and the tester (installed by hand, see README.md) -->
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>model</artifactId>
                <version>${patmal.api.version}</version>
            </dependency>
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>logic</artifactId>
                <version>${patmal.api.version}</version>
            </dependency>
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>workshop-tester</artifactId>
                <version>${patmal.tester.version}</version>
            </dependency>

            <!-- logging -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>

            <!-- e-mail validation -->
            <dependency>
                <groupId>commons-validator</groupId>
                <artifactId>commons-validator</artifactId>
                <version>${commons-validator.version}</version>
            </dependency>

            <!-- JSON -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- CSV import (bonus) -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
